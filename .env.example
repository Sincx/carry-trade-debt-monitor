# Copy to .env and fill in. Nothing here is required for the SEC/Treasury/FX
# collectors -- only Japan CPI (e-Stat) needs a key, and it's free.

# Free registration: https://www.e-stat.go.jp/api/
ESTAT_APP_ID=

# Optional: only needed for the Vercel-hosted read-only dashboard. When both
# are set, db/connection.py connects to this remote Turso (libSQL) database
# instead of the local db/monitor.db file. Leave unset for normal local use
# (collectors on the mini PC, dashboard also local) -- get these from
# https://app.turso.tech (create a database, then create a token for it).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
